/* ------------------------------------------------------------------ *
 * MAIN
 * ------------------------------------------------------------------ */

function run() {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return;
  try {
    processNewLeads();
    processReplies();
  } finally {
    lock.releaseLock();
  }
}


/* ------------------------------------------------------------------ *
 * EMAIL 1 - no AI
 * ------------------------------------------------------------------ */

function processNewLeads() {
  var threads = GmailApp.search('label:' + L_NEW + ' -label:' + L_DONE, 0, 10);
  Logger.log('New leads: ' + threads.length);

  for (var i = 0; i < threads.length; i++) {
    var msg  = newestMessage(threads[i]);
    var lead = parseHubSpot(msg.getPlainBody());

    if (!lead.email || !lead.parentName) {
      Logger.log('Could not parse lead, flagging for a human. ' +
                 JSON.stringify(lead));
      threads[i].addLabel(getLabel(L_ERROR));
      threads[i].addLabel(getLabel(L_DONE));
      continue;
    }

    var subject = 'School of Rock Springfield';
    var body    = openerFor(lead) + SIGNATURE;

    GmailApp.sendEmail(lead.email, subject, body);
    Logger.log('Opener sent to ' + lead.email + ' re ' + lead.studentName);

    var sent = tagSentThread(lead.email, subject);
    if (sent) saveLead(sent.getId(), lead);

    threads[i].addLabel(getLabel(L_DONE));
  }
}


/**
 * Everything the opener needs is a labelled field in the notification, so
 * this is a regex job. No model, no drift, no cost.
 */
function parseHubSpot(body) {
  // [ \t] rather than \s, or a blank field swallows the line below it.
  function grab(label) {
    var re = new RegExp(label + '[ \\t]*:[ \\t]*([^\\r\\n]*)', 'i');
    var m  = body.match(re);
    return m ? m[1].trim() : '';
  }

  var emails = body.match(/[\w.+-]+@[\w.-]+\.\w+/g) || [];
  var lead = emails.filter(function (e) {
    return e.toLowerCase().indexOf(SCHOOL_DOMAIN) === -1 &&
           e.toLowerCase().indexOf('hubspot') === -1;
  });

  var ageRaw = grab('Student Age');
  var ageNum = parseInt(ageRaw, 10);

  return {
    studentName: grab('Student Name'),
    studentAge:  isNaN(ageNum) ? null : ageNum,
    instrument:  grab('Instrument').toLowerCase(),
    parentName:  grab('Parent\\/Guardian'),
    email:       lead.length ? lead[0] : '',
    phone:       grab('Tel'),
    program:     programFor(isNaN(ageNum) ? null : ageNum)
  };
}


function programFor(age) {
  if (age === null)     return 'unknown';
  if (age >= ADULT_AGE) return 'Adult Program';
  if (age >= 14)        return 'Performance Program';
  if (age >= 8)         return 'Rock 101';
  if (age >= 6)         return 'Rookies';
  if (age >= 4)         return 'Little Wing';
  return 'unknown';
}


/**
 * Five branches. Adult with and without an instrument, child with and
 * without, and a softer one for the very young where "getting into it"
 * would be a stretch.
 */
function openerFor(lead) {
  var hi   = 'Hi ' + firstNameOf(lead.parentName) + '!';
  var seen = 'Just saw you filled out our form to learn more about ' +
             'School of Rock Springfield.';

  var kid  = lead.studentAge !== null && lead.studentAge < ADULT_AGE;
  var inst = lead.instrument && lead.instrument.length > 1;
  var name = lead.studentName || 'them';
  var ask;

  if (!kid) {
    ask = inst
      ? 'Tell me a bit about your experience with the ' + lead.instrument +
        ' and what has you interested in us!'
      : 'Tell me a bit about what has you interested in us!';

  } else if (lead.studentAge !== null && lead.studentAge < LITTLE_AGE) {
    ask = inst
      ? 'Could you tell me a bit about how ' + name + ' got interested in the ' +
        lead.instrument + ', and what you are hoping they get out of it?'
      : 'Could you tell me a bit about what you are hoping ' + name +
        ' gets out of it?';

  } else {
    ask = inst
      ? 'It\'s great to hear that ' + name + ' is getting into the ' +
        lead.instrument + ', could you tell me a bit about ' + name +
        '\'s experience and what brings you guys to us!'
      : 'It\'s fantastic that ' + name + ' is into music! Could you tell me a ' +
        'bit about what has you interested in us?';
  }

  return [hi, '', seen, '', ask].join('\n');
}


function firstNameOf(full) {
  return (full || '').trim().split(/\s+/)[0] || 'there';
}


/* ------------------------------------------------------------------ *
 * EMAIL 2+ - model writes
 * ------------------------------------------------------------------ */

function processReplies() {
  var q = 'label:' + L_THREAD +
          ' -label:' + L_BOOKED +
          ' -label:' + L_HANDOFF +
          ' -label:' + L_ERROR;

  var threads = GmailApp.search(q, 0, 20);
  var me = Session.getActiveUser().getEmail().toLowerCase();
  Logger.log('Active threads: ' + threads.length);

  for (var i = 0; i < threads.length; i++) {
    var messages = threads[i].getMessages();
    var last = messages[messages.length - 1];

    if (last.getFrom().toLowerCase().indexOf(me) !== -1) continue;

    if (messages.length > MAX_TURNS) {
      Logger.log('Hit turn limit, handing off');
      threads[i].addLabel(getLabel(L_HANDOFF));
      continue;
    }

    var lead = loadLead(threads[i].getId()) || {};

    var transcript = messages.map(function (m) {
      var who = m.getFrom().toLowerCase().indexOf(me) !== -1 ? 'Laurie' : 'Them';
      return who + ': ' + stripSignature(stripQuoted(m.getPlainBody()));
    }).join('\n\n');

    var context = [
      'What the form told us:',
      '  Student: '    + (lead.studentName || 'unknown'),
      '  Age: '        + (lead.studentAge === null || lead.studentAge === undefined
                          ? 'unknown' : lead.studentAge),
      '  Instrument: ' + (lead.instrument || 'not given'),
      '  Parent: '     + (lead.parentName || 'unknown'),
      '  Program: '    + (lead.program || 'unknown'),
      '',
      'The thread so far:',
      transcript
    ].join('\n');

    var res = callBrain(context);

    if (!res || !res.body) {
      Logger.log('Bad model response, flagging');
      threads[i].addLabel(getLabel(L_ERROR));
      continue;
    }

    var check = checkOutbound(res.body);
    if (!check.pass) {
      Logger.log('Guardrail blocked send:\n' + describeCheck(check));
      Logger.log('Blocked draft was:\n' + res.body);
      threads[i].addLabel(getLabel(L_ERROR));
      continue;
    }
    if (check.warns.length) {
      Logger.log('Sent with warnings:\n' + describeCheck(check));
    }

    threads[i].reply(res.body + SIGNATURE);

    // "confirming" means Laurie named a time and is waiting on a yes. The
    // thread stays open and nothing is written to the calendar.
    if (res.action === 'booked') {
      var written = bookCall(res, threads[i]);
      if (written) {
        threads[i].addLabel(getLabel(L_BOOKED));
      } else {
        Logger.log('Booked action but no event written, leaving thread open');
      }
    }
    if (res.action === 'handoff') {
      threads[i].addLabel(getLabel(L_HANDOFF));
    }

    Logger.log('Replied, action=' + res.action);
  }
}


/**
 * Last error from callBrain, so callers can report why a turn produced
 * nothing instead of logging "model returned nothing".
 */
var LAST_BRAIN_ERROR = '';

function callBrain(userText) {
  return callBrainWithRetry(userText, 2);
}

function callBrainWithRetry(userText, attempts) {
  for (var n = 1; n <= attempts; n++) {
    var r = callBrainOnce(userText);
    if (r) return r;
    Logger.log('attempt ' + n + ' of ' + attempts + ' failed: ' + LAST_BRAIN_ERROR);
    if (n < attempts) Utilities.sleep(1500);
  }
  return null;
}

function callBrainOnce(userText) {
  LAST_BRAIN_ERROR = '';

  var key = PropertiesService.getScriptProperties()
    .getProperty('ANTHROPIC_API_KEY');

  if (!key) {
    LAST_BRAIN_ERROR = 'missing ANTHROPIC_API_KEY';
    Logger.log(LAST_BRAIN_ERROR);
    return null;
  }

  var txt = '';
  var out = '';

  try {
    var res = UrlFetchApp.fetch('https://api.anthropic.com/v1/messages', {
      method: 'post',
      contentType: 'application/json',
      headers: {
        'x-api-key': key,
        'anthropic-version': '2023-06-01'
      },
      payload: JSON.stringify({
        model: MODEL,
        max_tokens: 1000,
        system: SYSTEM_PROMPT,
        messages: [{ role: 'user', content: todayLine() + userText }]
      }),
      muteHttpExceptions: true
    });

    var code = res.getResponseCode();
    txt = res.getContentText();

    if (code < 200 || code >= 300) {
      LAST_BRAIN_ERROR = 'http ' + code + ': ' + txt.substring(0, 200);
      Logger.log(LAST_BRAIN_ERROR);
      return null;
    }

    var parsed = JSON.parse(txt);

    if (parsed.stop_reason === 'max_tokens') {
      LAST_BRAIN_ERROR = 'hit max_tokens, JSON truncated';
      Logger.log(LAST_BRAIN_ERROR);
      return null;
    }

    out = parsed.content
      .filter(function (b) { return b.type === 'text'; })
      .map(function (b) { return b.text; })
      .join('')
      .replace(/```json/g, '')
      .replace(/```/g, '')
      .trim();

    // Models sometimes wrap the object in prose. Take the outermost braces.
    var first = out.indexOf('{');
    var last  = out.lastIndexOf('}');
    if (first > 0 || (last !== -1 && last < out.length - 1)) {
      if (first !== -1 && last > first) out = out.substring(first, last + 1);
    }

    Logger.log('Brain: ' + out);
    return JSON.parse(escapeControlChars(out));

  } catch (e) {
    LAST_BRAIN_ERROR = String(e) + ' | raw: ' + out.substring(0, 300);
    Logger.log('callBrain failed: ' + LAST_BRAIN_ERROR);
    return null;
  }
}


/* ------------------------------------------------------------------ *
 * CALENDAR
 * ------------------------------------------------------------------ */

function bookCall(res, thread) {
  var e   = res.extracted || {};
  var iso = e.agreedTimeISO;

  if (!iso) {
    Logger.log('Booked but no agreedTimeISO, no event created');
    return false;
  }

  var start = new Date(iso);
  if (isNaN(start.getTime())) {
    Logger.log('Unparseable time: ' + iso);
    return false;
  }

  try {
    var end  = new Date(start.getTime() + CALL_MINUTES * 60 * 1000);
    var lead = loadLead(thread.getId()) || {};
    var who  = e.studentName || lead.studentName || 'lead';

    var desc = [
      'Parent: '     + (lead.parentName || 'unknown'),
      'Phone: '      + (lead.phone || 'unknown'),
      'Email: '      + (lead.email || 'unknown'),
      '',
      'Student: '    + who,
      'Age: '        + (e.studentAge || lead.studentAge || 'unknown'),
      'Instrument: ' + (e.instrument || lead.instrument || 'not given'),
      'Program: '    + (e.program || lead.program || 'unknown'),
      '',
      'Notes: '      + (e.notesForBill || 'none'),
      '',
      'Thread: '     + thread.getPermalink()
    ].join('\n');

    CalendarApp.getCalendarById(CALENDAR_ID)
      .createEvent('SoR call: ' + who, start, end, { description: desc });

    Logger.log('Booked ' + iso + ' for ' + who);
    return true;

  } catch (err) {
    Logger.log('Calendar failed: ' + err);
    return false;
  }
}


/* ------------------------------------------------------------------ *
 * HELPERS
 * ------------------------------------------------------------------ */

function saveLead(threadId, lead) {
  try {
    PropertiesService.getScriptProperties()
      .setProperty('lead_' + threadId, JSON.stringify(lead));
  } catch (e) {
    Logger.log('saveLead failed: ' + e);
  }
}

function loadLead(threadId) {
  try {
    var raw = PropertiesService.getScriptProperties()
      .getProperty('lead_' + threadId);
    return raw ? JSON.parse(raw) : null;
  } catch (e) {
    return null;
  }
}


function todayLine() {
  return 'Today is ' +
    Utilities.formatDate(new Date(), TIMEZONE, 'EEEE, MMMM d, yyyy') + '.\n\n';
}


/**
 * Models sometimes emit raw newlines inside JSON string values, which is
 * invalid. Escape control chars only when inside a string so the structural
 * formatting between properties survives.
 */
function escapeControlChars(s) {
  var res = '';
  var inStr = false;
  var esc = false;

  for (var i = 0; i < s.length; i++) {
    var c = s[i];

    if (esc) { res += c; esc = false; continue; }
    if (c === '\\' && inStr) { res += c; esc = true; continue; }
    if (c === '"') { inStr = !inStr; res += c; continue; }

    if (inStr && c < ' ') {
      if (c === '\n') res += '\\n';
      else if (c === '\t') res += '\\t';
      continue;
    }

    res += c;
  }
  return res;
}


function stripQuoted(body) {
  return body.split('\n').filter(function (l) {
    return l.indexOf('>') !== 0;
  }).join('\n').trim();
}


/** Keeps the legal boilerplate out of the transcript we pay to send. */
function stripSignature(body) {
  var cut = body.indexOf('This email and any files transmitted');
  if (cut !== -1) body = body.substring(0, cut);
  cut = body.indexOf('School of Rock Springfield, VA');
  if (cut !== -1) body = body.substring(0, cut);
  return body.trim();
}


function tagSentThread(toEmail, subject) {
  Utilities.sleep(3000);
  var threads = GmailApp.search('in:sent to:' + toEmail, 0, 3);
  for (var i = 0; i < threads.length; i++) {
    if (threads[i].getFirstMessageSubject() === subject) {
      threads[i].addLabel(getLabel(L_THREAD));
      return threads[i];
    }
  }
  Logger.log('Could not tag sent thread: ' + toEmail);
  return null;
}


function newestMessage(thread) {
  var m = thread.getMessages();
  return m[m.length - 1];
}

function getLabel(name) {
  return GmailApp.getUserLabelByName(name) || GmailApp.createLabel(name);
}

function setupLabels() {
  [L_NEW, L_DONE, L_THREAD, L_BOOKED, L_HANDOFF, L_ERROR].forEach(getLabel);
  Logger.log('Labels ready');
}


