var MAX_SENTENCES = 4;   // real business email: median 3, 63% are 3 or fewer


/**
 * Style rules matter in aggregate, not to the individual lead. A stock closing
 * sentence does no harm to the parent reading it, so blocking a live send over
 * one stalls a real conversation for a cosmetic reason. In evals everything
 * blocks, because that is where repetition is the thing being measured.
 *
 * Set by the harness before a run. Leave it 'production' otherwise.
 */
var CHECK_MODE = 'production';

var STYLE_RULES = [
  'stock_closer', 'stock_bill_line', 'quick_call', 'exactly',
  'service_speak', 'filler_opener', 'performed_excitement',
  'contrastive', 'good_fit_stock'
];


/**
 * Returns { pass, blocks:[], warns:[] }.
 * Caller decides what to do; this function never sends or labels.
 */
function checkOutbound(text) {
  var blocks = [];
  var warns  = [];

  for (var i = 0; i < RULES.length; i++) {
    var r = RULES[i];
    var m = text.match(r.re);
    if (!m) continue;

    var hit = { id: r.id, why: r.why, match: m[0].substring(0, 60) };

    var isStyle  = STYLE_RULES.indexOf(r.id) !== -1;
    var blocking = (r.severity === 'block') &&
                   (CHECK_MODE === 'eval' || !isStyle);

    if (blocking) blocks.push(hit);
    else warns.push(hit);
  }

  var n = countSentences(text);
  if (n > MAX_SENTENCES) {
    warns.push({
      id: 'too_long',
      why: n + ' sentences, target is ' + MAX_SENTENCES + ' or fewer.',
      match: ''
    });
  }

  return { pass: blocks.length === 0, blocks: blocks, warns: warns };
}


function countSentences(text) {
  var t = text.replace(/\s+/g, ' ').trim();
  if (!t) return 0;
  return t.split(/[.!?]+(?=\s|$)/).filter(function (s) {
    return s.trim().length > 1;
  }).length;
}


function describeCheck(result) {
  var out = [];
  result.blocks.forEach(function (b) { out.push('BLOCK ' + b.id + ': ' + b.why); });
  result.warns.forEach(function (w) { out.push('warn  ' + w.id + ': ' + w.why); });
  return out.length ? out.join('\n') : 'clean';
}


