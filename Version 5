var EVAL_BUDGET_MS = 4.5 * 60 * 1000;   // stop before the 6 min cap
var CURSOR_KEY     = 'eval_cursor';


/**
 * Apps Script kills anything past 6 minutes on a consumer account, and a full
 * run is 35 turns at two API calls each. So this processes what it can, saves
 * its place, and picks up there next time. Run it repeatedly until it says
 * the run is complete.
 *
 * resetEvals() clears the cursor and starts over.
 */
function runEvals() {
  CHECK_MODE = 'eval';
  var began = new Date().getTime();
  var props = PropertiesService.getScriptProperties();

  var start = parseInt(props.getProperty(CURSOR_KEY) || '0', 10);
  if (start === 0) props.setProperty('eval_stamp', new Date().toISOString());
  var stamp = new Date(props.getProperty('eval_stamp'));

  var sheet = getSheet();
  var i;

  for (i = start; i < SCENARIOS.length; i++) {
    if (new Date().getTime() - began > EVAL_BUDGET_MS) break;

    var r = runScenario(SCENARIOS[i]);
    var rows = [];

    for (var t = 0; t < r.turns.length; t++) {
      var x = r.turns[t];
      rows.push([
        stamp, PROMPT_VERSION, r.id, t + 1,
        x.pass ? 'PASS' : 'FAIL',
        x.failures.join('; '),
        x.action, x.expected,
        x.grade.specificDetail || '',
        x.grade.sentences || '',
        x.body
      ]);
    }

    sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, rows[0].length)
         .setValues(rows);

    Logger.log((i + 1) + '/' + SCENARIOS.length + '  ' + r.id + ': ' +
               (r.pass ? 'PASS' : 'FAIL'));
  }

  CHECK_MODE = 'production';

  if (i >= SCENARIOS.length) {
    props.deleteProperty(CURSOR_KEY);
    Logger.log('---');
    Logger.log('run complete, all ' + SCENARIOS.length + ' scenarios');
    Logger.log('now run repetitionReport()');
  } else {
    props.setProperty(CURSOR_KEY, String(i));
    Logger.log('---');
    Logger.log('stopped at ' + i + ' of ' + SCENARIOS.length +
               '. Run runEvals() again to continue.');
  }
  Logger.log('Sheet: ' + sheet.getParent().getUrl());
}


