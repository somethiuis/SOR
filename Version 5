function runOne(id) {
  CHECK_MODE = 'eval';
  var s = SCENARIOS.filter(function (x) { return x.id === id; })[0];
  if (!s) { Logger.log('No scenario ' + id); return; }

  var r = runScenario(s);
  Logger.log('=== ' + r.id + ' ===');
  r.turns.forEach(function (t, i) {
    Logger.log('\n--- turn ' + (i + 1) + ' ---');
    Logger.log('THEM: ' + t.them);
    Logger.log('LAURIE: ' + t.body);
    Logger.log('action=' + t.action + ' expected=' + t.expected);
    Logger.log(t.pass ? 'PASS' : 'FAIL: ' + t.failures.join('; '));
  });
  CHECK_MODE = 'production';
}


/**
 * Walks one scenario. Builds the same context string processReplies builds,
 * so the model sees exactly what it sees in production.
 */
function runScenario(s) {
  var transcript = [];
  var results    = [];
  var allPass    = true;

  transcript.push('Laurie: ' + openerFor(s.lead));

  for (var t = 0; t < s.turns.length; t++) {
    transcript.push('Them: ' + s.turns[t]);

    var context = [
      'What the form told us:',
      '  Student: '    + (s.lead.studentName || 'unknown'),
      '  Age: '        + (s.lead.studentAge === null ? 'unknown' : s.lead.studentAge),
      '  Instrument: ' + (s.lead.instrument || 'not given'),
      '  Parent: '     + (s.lead.parentName || 'unknown'),
      '  Program: '    + (s.lead.program || 'unknown'),
      '',
      'The thread so far:',
      transcript.join('\n\n')
    ].join('\n');

    var res = callBrain(context);

    if (!res || !res.body) {
      results.push({
        them: s.turns[t], body: '(no response)', action: 'error',
        expected: s.expect[t], pass: false,
        failures: ['no response: ' + LAST_BRAIN_ERROR], grade: {}
      });
      allPass = false;
      continue;
    }

    var scored = scoreTurn(res, s, t);
    results.push(scored);
    if (!scored.pass) allPass = false;

    transcript.push('Laurie: ' + res.body);
  }

  return { id: s.id, pass: allPass, turns: results };
}


/**
 * Guardrails first, free and certain. Model extraction second. Thresholds
 * applied here, never by the model.
 */
function scoreTurn(res, scenario, turnIndex) {
  var failures = [];
  var body     = res.body;

  var g = checkOutbound(body);
  g.blocks.forEach(function (b) { failures.push('guardrail:' + b.id); });

  var expected = scenario.expect[turnIndex];
  if (res.action !== expected) {
    failures.push('action=' + res.action + ' expected=' + expected);
  }

  if (expected === 'booked' && !(res.extracted && res.extracted.agreedTimeISO)) {
    failures.push('booked without agreedTimeISO');
  }

  // Booking off a time the lead never agreed to is the failure this catches.
  if (res.action === 'booked' && expected === 'confirming') {
    failures.push('booked before the lead confirmed a time');
  }

  var grade = gradeBody(body, scenario, turnIndex);

  if (grade.price      && grade.price      !== 'NONE') failures.push('price:' + grade.price);
  if (grade.date       && grade.date       !== 'NONE') failures.push('date:' + grade.date);
  if (grade.availability && grade.availability !== 'NONE') failures.push('availability');
  if (grade.placement  && grade.placement  !== 'NONE') failures.push('placement');
  if (grade.negationDefine && grade.negationDefine !== 'NONE') failures.push('negation-define');
  if (grade.falsePromise && grade.falsePromise !== 'NONE') failures.push('false-promise:' + grade.falsePromise);
  if (grade.invented   && grade.invented   !== 'NONE') failures.push('invented:' + grade.invented);

  if (grade.sentences > MAX_SENTENCES) {
    failures.push('sentences=' + grade.sentences);
  }

  // Whether a detail was owed is declared per turn in the scenario. Inferring
  // it from message length flagged pure questions as missing a detail they
  // were never given.
  var needsDetail = scenario.needsDetail && scenario.needsDetail[turnIndex];
  if (needsDetail &&
      (!grade.specificDetail || grade.specificDetail === 'NONE')) {
    failures.push('no specific detail reflected');
  }

  return {
    them: scenario.turns[turnIndex],
    body: body,
    action: res.action,
    expected: expected,
    pass: failures.length === 0,
    failures: failures,
    grade: grade,
    warns: g.warns.map(function (w) { return w.id; })
  };
}


function gradeBody(body, scenario, turnIndex) {
  var leadSaid = scenario.turns.slice(0, turnIndex + 1).join('\n');

  var input = [
    'Form data for this lead:',
    JSON.stringify(scenario.lead),
    '',
    'Everything the lead has written:',
    leadSaid,
    '',
    'The email to analyze:',
    body
  ].join('\n');

  var key = PropertiesService.getScriptProperties()
    .getProperty('ANTHROPIC_API_KEY');

  try {
    var res = UrlFetchApp.fetch('https://api.anthropic.com/v1/messages', {
      method: 'post',
      contentType: 'application/json',
      headers: { 'x-api-key': key, 'anthropic-version': '2023-06-01' },
      payload: JSON.stringify({
        model: GRADER_MODEL,
        max_tokens: 700,
        system: GRADER_PROMPT,
        messages: [{ role: 'user', content: input }]
      }),
      muteHttpExceptions: true
    });

    if (res.getResponseCode() !== 200) {
      Logger.log('Grader ' + res.getResponseCode());
      return {};
    }

    var out = JSON.parse(res.getContentText()).content
      .filter(function (b) { return b.type === 'text'; })
      .map(function (b) { return b.text; })
      .join('')
      .replace(/```json/g, '').replace(/```/g, '').trim();

    return JSON.parse(escapeControlChars(out));

  } catch (e) {
    Logger.log('gradeBody failed: ' + e);
    return {};
  }
}


/**
 * Repetition is invisible one email at a time. This measures the whole run
 * against a baseline from 30,000 real sent business emails, where 9,120 of
 * 12,197 closing sentences were unique, so roughly 75% uniqueness and no
 * single closer above about 5%.
 *
 * Run after runEvals(). Reads the bodies back out of the Sheet.
 */
function repetitionReport() {
  var sheet = getSheet();
  var data  = sheet.getDataRange().getValues();
  var head  = data[0];
  var vCol  = head.indexOf('promptVer');
  var bCol  = head.indexOf('body');

  var latest = '';
  for (var i = 1; i < data.length; i++) {
    if (data[i][vCol]) latest = data[i][vCol];
  }

  var bodies = [];
  for (var j = 1; j < data.length; j++) {
    if (data[j][vCol] !== latest) continue;
    var b = String(data[j][bCol] || '');
    if (b && b !== '(no response)') bodies.push(b);
  }

  if (!bodies.length) { Logger.log('No bodies for ' + latest); return; }

  var closers = {};
  bodies.forEach(function (b) {
    var s = b.replace(/\s+/g, ' ').trim().split(/(?<=[.!?])\s+/);
    var last = (s[s.length - 1] || '').toLowerCase().replace(/[^a-z0-9?' ]/g, '').trim();
    if (last) closers[last] = (closers[last] || 0) + 1;
  });

  var keys = Object.keys(closers);
  var top = keys.sort(function (a, b) { return closers[b] - closers[a]; });

  Logger.log('=== repetition, ' + latest + ' ===');
  Logger.log('emails: ' + bodies.length);
  Logger.log('distinct closers: ' + keys.length +
             '  (' + Math.round(keys.length / bodies.length * 100) + '% unique)');
  Logger.log('real business email baseline: 75% unique');
  Logger.log('');
  Logger.log('most repeated closers:');
  top.slice(0, 5).forEach(function (k) {
    if (closers[k] > 1) {
      Logger.log('  ' + closers[k] + 'x  ' + k.substring(0, 70));
    }
  });

  var worst = closers[top[0]] / bodies.length;
  Logger.log('');
  Logger.log('top closer share: ' + Math.round(worst * 100) + '%  (baseline about 5%)');
}


function getSheet() {
  var files = DriveApp.getFilesByName(SHEET_NAME);
  var ss = files.hasNext()
    ? SpreadsheetApp.open(files.next())
    : SpreadsheetApp.create(SHEET_NAME);

  var sheet = ss.getSheets()[0];
  if (sheet.getLastRow() === 0) {
    sheet.appendRow([
      'run', 'promptVer', 'scenario', 'turn', 'result', 'failures',
      'action', 'expected', 'detailReflected', 'sentences', 'body'
    ]);
    sheet.setFrozenRows(1);
  }
  return sheet;
}


/**
 * Grade twenty turns by hand, then run this. If the grader disagrees with you
 * often, the rubric is wrong and no automated score below it means anything.
 *
 * Fill LABELLED with your own pass/fail calls first.
 */
var LABELLED = [
  // { scenario: 'S01_eager_parent', turn: 1, humanSaysPass: true },
];

function checkGraderAgreement() {
  if (!LABELLED.length) {
    Logger.log('LABELLED is empty. Hand-grade twenty turns first.');
    return;
  }
  var agree = 0;
  LABELLED.forEach(function (l) {
    var s = SCENARIOS.filter(function (x) { return x.id === l.scenario; })[0];
    var r = runScenario(s);
    var t = r.turns[l.turn - 1];
    var match = (t.pass === l.humanSaysPass);
    if (match) agree++;
    Logger.log((match ? 'agree    ' : 'DISAGREE ') + l.scenario + ' turn ' + l.turn +
               '  human=' + l.humanSaysPass + ' grader=' + t.pass +
               (match ? '' : '  [' + t.failures.join('; ') + ']'));
  });
  Logger.log('---');
  Logger.log(agree + '/' + LABELLED.length + ' agreement');
}
