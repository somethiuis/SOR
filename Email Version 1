/**
 * School of Rock Springfield - Email conversation agent
 *
 * Email 1 is parsed and templated with no AI at all. Everything the opener
 * needs is already in the HubSpot notification, so there is nothing for a
 * model to add except drift.
 *
 * The model only writes from email 2 onward, where it has to react to
 * something a real person typed.
 *
 * SETUP (once):
 *   1. Project Settings > Script Properties:
 *        ANTHROPIC_API_KEY = sk-ant-...
 *   2. Run setupLabels()
 *   3. Gmail filter: subject contains "New Lead - Contact" -> apply NewLead
 *   4. Trigger run() every minute
 */

var MODEL     = 'claude-sonnet-4-6';
var MAX_TURNS = 8;

var CALENDAR_ID  = 'primary';   // swap for the school calendar
var CALL_MINUTES = 15;
var TIMEZONE     = 'America/New_York';

var SCHOOL_DOMAIN = 'schoolofrock.com';
var ADULT_AGE     = 18;
var LITTLE_AGE    = 6;          // below this, "getting into it" reads wrong

var L_NEW     = 'NewLead';
var L_DONE    = 'Processed';
var L_THREAD  = 'SoRLead';
var L_BOOKED  = 'SoRBooked';
var L_HANDOFF = 'SoRHandoff';
var L_ERROR   = 'SoRError';


var SIGNATURE = [
  '',
  'Best,',
  'Laurie',
  'School of Rock Springfield, VA',
  '(703) 755-7276'
].join('\n');

var LEGAL = [
  '',
  '',
  'This email and any files transmitted with it are confidential and intended ' +
  'solely for the use of the individual or entity to whom they are addressed. ' +
  'If you have received this email in error please notify the system manager. ' +
  'This message contains confidential information and is intended only for the ' +
  'individual named. If you are not the named addressee you should not ' +
  'disseminate, distribute or copy this e-mail. Please notify the sender ' +
  'immediately by e-mail if you have received this e-mail by mistake and delete ' +
  'this e-mail from your system. If you are not the intended recipient you are ' +
  'notified that disclosing, copying, distributing or taking any action in ' +
  'reliance on the contents of this information is strictly prohibited.'
].join('\n');


